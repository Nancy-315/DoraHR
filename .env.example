# DoraHR MBA Assistant - Environment Variables
# Configure ONE of the following AI API keys to enable live AI responses in Vercel:

# Option 1: OpenAI or OpenAI-Compatible API Key
AI_API_KEY=your_openai_api_key_here
# Optional: Specify model (defaults to gpt-4o-mini)
# AI_MODEL=gpt-4o-mini
# Optional: Custom base URL (e.g., https://api.groq.com/openai/v1 or https://openrouter.ai/api/v1)
# AI_BASE_URL=https://api.openai.com/v1

# Option 2: Groq API Key (Fast & Free Tier Available)
# GROQ_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# Option 3: Google Gemini API Key
# GEMINI_API_KEY=AIzaSy...
# AI_MODEL=gemini-1.5-flash
